{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Strip trailing slash on non-root paths (canonical = no slash).
	@trailingSlash {
		path_regexp slash ^(.+)/$
	}
	redir @trailingSlash {re.slash.1} 308

	# Permanent redirects for the builder -> builders rename.
	redir /builder-vs-naysayers-ten-dimensions /builders-vs-naysayers-ten-dimensions 301
	redir /tools/builder-vs-naysayers /tools/builders-vs-naysayers 301

	# acceptmarkdown.com: reject a request that accepts neither markdown nor
	# html (nor a wildcard) with 406 instead of silently handing it html.
	# Scoped to the pages that actually negotiate, so an asset or feed fetch
	# with a narrow Accept is left alone. `respond` is ordered AFTER `rewrite`,
	# so these match on the original request path, not the rewritten one.
	@unacceptable {
		header Accept *
		not header_regexp Accept (?i)(text/html|text/markdown|text/plain|text/\*|\*/\*)
		file {http.request.orig_uri.path}.md
	}
	respond @unacceptable 406
	@unacceptableRoot {
		expression {http.request.orig_uri.path} == "/"
		header Accept *
		not header_regexp Accept (?i)(text/html|text/markdown|text/plain|text/\*|\*/\*)
	}
	respond @unacceptableRoot 406

	# Content negotiation: agents asking for markdown get the page source.
	# Only rewrites when a sibling .md was actually built (posts and the
	# prose pages), so every other path falls through to the HTML below.
	# `text/markdown;q=0` is an explicit refusal and does not count as asking.
	# ponytail: substring match, not a full q-value ranking. An Accept that
	# ranks html above markdown with fractional q values still gets markdown;
	# real ranking needs a negotiating handler, not a Caddyfile matcher.
	@wantsMarkdown {
		header Accept *text/markdown*
		not header_regexp Accept text/markdown\s*;\s*q=0(\.0*)?(\s*[,;]|\s*$)
		file {path}.md
	}
	rewrite @wantsMarkdown {path}.md

	# Same negotiation for the homepage, whose markdown lives at /index.md.
	@wantsMarkdownRoot {
		path /
		header Accept *text/markdown*
		not header_regexp Accept text/markdown\s*;\s*q=0(\.0*)?(\s*[,;]|\s*$)
	}
	rewrite @wantsMarkdownRoot /index.md

	# Astro emits pretty URLs as /path.html — let Caddy find them.
	try_files {path} {path}.html {path}/index.html =404

	file_server

	# Serve the built 404 page, preserving the 404 status code.
	handle_errors {
		@notFound expression {err.status_code} == 404
		rewrite @notFound /404.html
		file_server
	}

	header {
		# Conservative defaults; tighten later if we care.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Post URLs serve HTML or markdown depending on Accept, so caches must
	# key on it. Without this a CDN serves whichever variant it cached first.
	# .md also needs an explicit type: file_server has no mapping for it and
	# would send the source with no Content-Type at all. Note `header` is
	# ordered BEFORE `rewrite`, so its matchers see the pre-rewrite path;
	# the negotiated case has to match the request, not the .md path.
	@markdown path *.md
	header @markdown {
		Content-Type "text/markdown; charset=utf-8"
		Vary "Accept, Accept-Encoding"
	}
	header @wantsMarkdown Content-Type "text/markdown; charset=utf-8"
	header @wantsMarkdownRoot Content-Type "text/markdown; charset=utf-8"

	@negotiableHtml file {path}.md
	header @negotiableHtml Vary "Accept, Accept-Encoding"

	@rootHtml path /
	header @rootHtml Vary "Accept, Accept-Encoding"

	log {
		output stdout
		format console
	}
}
