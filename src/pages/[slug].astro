---
import Layout from '../layouts/Layout.astro';
import CapToggle from '../components/CapToggle.astro';
import Icon from '../components/Icon.astro';
import Giscus from '../components/Giscus.astro';
import { render } from 'astro:content';
import { readMinutes, excerpt, fmtDate, getRoutablePosts, updatedIso } from '../lib/post-utils';

export async function getStaticPaths() {
  const posts = (await getRoutablePosts()).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  );
  return posts.map((post, i) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      prev: posts[i - 1] ?? null,
      next: posts[i + 1] ?? null,
      all: posts,
    },
  }));
}

const { post, prev, next, all } = Astro.props;
const { Content } = await render(post);

const tagSet = new Set(post.data.tags);
const related = all
  .filter((p) => !p.data.draft && p.data.slug !== post.data.slug && p.data.tags.some((t) => tagSet.has(t)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const minRead = readMinutes(post.body ?? '');
const postDesc = post.data.description ?? excerpt(post.body ?? '', 200);
// Slashless, matching <link rel="canonical"> and the 308 Caddy sends for a
// trailing slash. Two different urls for one page is a fact an agent has to
// reconcile, so don't hand it two.
const canonicalUrl = new URL(`/${post.data.slug}`, Astro.site).toString();
const modifiedIso = updatedIso(post.data.updated_at);

// The Layout folds this into its @graph with the Person and WebSite nodes, so
// author/publisher are references rather than a second copy of the identity.
const jsonLd = {
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#post`,
  headline: post.data.title,
  description: postDesc,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  datePublished: post.data.date.toISOString(),
  ...(modifiedIso ? { dateModified: modifiedIso } : {}),
  author: { '@id': `${Astro.site}#person` },
  publisher: { '@id': `${Astro.site}#person` },
  isPartOf: { '@id': `${Astro.site}#website` },
  keywords: post.data.tags.join(', '),
};
---

<Layout
  title={post.data.title}
  description={postDesc}
  ogImageAlt={post.data.title}
  customCapToggle={post.data.custom_cap_toggle}
  article={{
    publishedTime: post.data.date,
    modifiedTime: modifiedIso,
    tags: post.data.tags,
    jsonLd,
  }}
>
  <article class="post" data-pagefind-body>
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <Icon name="calendar" />{fmtDate(post.data.date)}
        <span class="sep">·</span>
        <Icon name="clock" />{minRead} min read
        <CapToggle />
      </p>
    </header>
    <Content />
    <footer class="post-footer" data-pagefind-ignore>
      {post.data.updated_at && (
        <p class="meta updated"><Icon name="calendar" />Updated: {post.data.updated_at}</p>
      )}
      {post.data.tags.length > 0 && (
        <p class="post-tags tags">
          <span class="label">Tags:</span>
          {post.data.tags.map((t) => <a href={`/tags#${t}`}>#{t}</a>)}
        </p>
      )}
    </footer>
  </article>

  {(prev || next) && (
    <nav class="post-nav" data-pagefind-ignore>
      <div class="prev">
        {prev && (
          <>
            <span class="label">previous:</span>
            <a href={`/${prev.data.slug}/`}>{prev.data.title}</a>
          </>
        )}
      </div>
      <div class="next">
        {next && (
          <>
            <span class="label">next:</span>
            <a href={`/${next.data.slug}/`}>{next.data.title}</a>
          </>
        )}
      </div>
    </nav>
  )}

  {related.length > 0 && (
    <section class="related" data-pagefind-ignore>
      <h3 class="archive__subtitle">you may also enjoy</h3>
      <div class="related-grid">
        {related.map((r) => (
          <article class="related-entry">
            <h4 class="related-title">
              <a href={`/${r.data.slug}/`}>{r.data.title}</a>
            </h4>
            <p class="meta"><Icon name="calendar" />{fmtDate(r.data.date)} · <Icon name="clock" />{readMinutes(r.body ?? '')} min</p>
            <p class="excerpt">{excerpt(r.body ?? '', 120)}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <Giscus />
</Layout>

<script is:inline>
  (function () {
    var LINK_SVG = '<svg viewBox="0 0 640 512" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M579.8 267.7c56.5-56.5 56.5-148 0-204.5c-50-50-128.8-56.5-186.3-15.4l-1.6 1.1c-14.4 10.3-17.7 30.3-7.4 44.6s30.3 17.7 44.6 7.4l1.6-1.1c32.1-22.9 76-19.3 103.8 8.6c31.5 31.5 31.5 82.5 0 114L422.3 334.8c-31.5 31.5-82.5 31.5-114 0c-27.9-27.9-31.5-71.8-8.6-103.8l1.1-1.6c10.3-14.4 6.9-34.4-7.4-44.6s-34.4-6.9-44.6 7.4l-1.1 1.6C206.5 251.3 213 330.1 263 380.1c56.5 56.5 148 56.5 204.5 0L579.8 267.7zM60.2 244.3c-56.5 56.5-56.5 148 0 204.5c50 50 128.8 56.5 186.3 15.4l1.6-1.1c14.4-10.3 17.7-30.3 7.4-44.6s-30.3-17.7-44.6-7.4l-1.6 1.1c-32.1 22.9-76 19.3-103.8-8.6C74 372 74 321 105.5 289.5L217.7 177.2c31.5-31.5 82.5-31.5 114 0c27.9 27.9 31.5 71.8 8.6 103.9l-1.1 1.6c-10.3 14.4-6.9 34.4 7.4 44.6s34.4 6.9 44.6-7.4l1.1-1.6C433.5 260.7 427 181.9 377 131.9c-56.5-56.5-148-56.5-204.5 0L60.2 244.3z"/></svg>';

    function copyLinkFor(h) {
      var url = location.origin + location.pathname + '#' + h.id;
      history.replaceState(null, '', '#' + h.id);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(url);
      }
      return Promise.resolve();
    }

    function decorate() {
      var headings = document.querySelectorAll('article.post :is(h2, h3, h4)[id]');
      headings.forEach(function (h) {
        if (h.dataset.anchored) return;
        h.dataset.anchored = '1';
        h.classList.add('linkable-heading');

        var icon = document.createElement('span');
        icon.className = 'heading-anchor';
        icon.setAttribute('aria-hidden', 'true');
        icon.innerHTML = LINK_SVG;
        h.appendChild(icon);

        h.addEventListener('click', function (e) {
          if (e.target.closest('a')) return;
          e.preventDefault();
          copyLinkFor(h).then(function () {
            h.dataset.copied = '1';
            setTimeout(function () { delete h.dataset.copied; }, 1200);
          });
        });
      });
    }
    decorate();
    document.addEventListener('astro:page-load', decorate);
  })();
</script>

<style is:global>
  article.post .linkable-heading {
    cursor: pointer;
    position: relative;
  }
  article.post .heading-anchor {
    display: inline-block;
    margin-left: 0.4em;
    color: var(--accent, #888);
    opacity: 0;
    transition: opacity 0.15s ease;
    vertical-align: -0.05em;
  }
  article.post .linkable-heading:hover .heading-anchor,
  article.post .linkable-heading:focus-within .heading-anchor {
    opacity: 0.7;
  }
  article.post .linkable-heading[data-copied="1"]::after {
    content: " link copied";
    font-size: 0.55em;
    margin-left: 0.4em;
    color: var(--accent, #888);
    font-weight: normal;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    vertical-align: middle;
  }
  @media (hover: none) {
    article.post .heading-anchor { opacity: 0.5; }
  }
</style>
