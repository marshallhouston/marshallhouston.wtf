---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const kernels = (await getCollection('kernels')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const monthLabel = (d: Date) =>
  d.toLocaleString('en-US', { month: 'long', year: 'numeric' }).toLowerCase();

// Ideas may carry links: `[words](url)` links those words, a bare url links its host.
const parts = (text: string) =>
  text.split(/(\[[^\]]+\]\(https?:\/\/[^\s)]+\)|https?:\/\/[^\s]+)/g).map((p) => {
    const md = p.match(/^\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)$/);
    if (md) return { href: md[2], label: md[1], inline: true };
    if (!/^https?:\/\//.test(p)) return { text: p };
    const href = p.replace(/[.,;:!?)\]]+$/, '');
    return { href, label: new URL(href).hostname.replace(/^www\./, '') };
  });

// Group by month preserving order.
const groups: { month: string; items: typeof kernels }[] = [];
for (const k of kernels) {
  const m = monthLabel(k.data.date);
  const last = groups[groups.length - 1];
  if (last && last.month === m) last.items.push(k);
  else groups.push({ month: m, items: [k] });
}
---

<Layout title="kernels">
  <h1>kernels</h1>
  <p>one-sentence ideas. seeds that might become something.</p>

  {groups.map((g) => (
    <section data-pagefind-body>
      <h2 class="month">{g.month}</h2>
      <ul>
        {g.items.map((k) => (
          <li>
            {parts(k.data.idea).map((p) =>
              p.href ? (
                <a href={p.href} class={p.inline ? '' : 'src'} target="_blank" rel="noopener">
                  {p.label}
                </a>
              ) : p.text
            )}
            {k.data.sprouted && k.data.post_url && (
              <> &rarr; <a href={k.data.post_url}>{k.data.post_title}</a></>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<style>
  h2.month {
    font-size: 1.25em;
  }

  a.src {
    font-size: 0.85em;
    white-space: nowrap;
  }
  a.src::before {
    content: '\2197\00a0';
    opacity: 0.6;
  }
</style>
